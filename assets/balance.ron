// Iron Dots — balance parameters (spec section 2.8).
//
// Values are in human units: HP, seconds, tiles, money. Decimals are written as
// strings ("9.2") so the simulation never parses floating point. The simulation
// converts everything to ticks and integers on load.
//
// Any change here changes sim_version (the hash of this content is part of it).
// Values marked "proposal" are placeholders until measured (spec 2.11).
(
    tick_rate: 30,

    unit: (
        max_hp: 100,
        // Distance between the centres of two touching units: dots are solid
        // bodies 1.5 tiles across and are pushed apart when closer. proposal
        separation_radius: "1.5",
        // Speed multiplier while in contact with an enemy. proposal
        engaged_speed: "0.5",
        light: (speed: "2.0", atk: "1.0", def: "1.0", supply: 1, cost: 200, upkeep: "1"),
        heavy: (speed: "1.0", atk: "1.5", def: "1.5", supply: 2, cost: 400, upkeep: "2"),
    ),

    combat: (
        // Also the spatial grid cell size.
        // Units fight when their centres are this close: touching bodies.
        contact_radius: "1.75",
        // HP/s; a duel of two equal light units without morale lasts ~15 s.
        base_dps: "9.2",
        // Damage multiplier taken by the attacking side. proposal
        attacker_taken: "1.25",
    ),

    morale: (
        max: 100,
        loss_attack: "4",   // per second, proposal
        loss_defend: "1",   // per second, proposal
        regen: "5",         // per second out of combat, proposal
    ),

    // Money: each city pays city_income per second; units outside cities cost
    // their upkeep per second. Settled once per second.
    economy: (city_income: "10", start_money: 200),
    // Supply is counted per pocket (connected piece of a player's territory):
    // per_city places for every city in it. Overloaded units starve at
    // starve_dps × (used − limit) / limit HP/s (at most starve_dps); with an
    // empty treasury units outside cities lose broke_starve_dps. Units heal
    // after heal_delay seconds out of combat on own or allied land.
    supply: (
        per_city: 5,
        starve_dps: "5",
        broke_starve_dps: "2",
        heal_dps: "2",
        heal_city_dps: "4",
        heal_delay: "3",
    ),
    // Control zones: a tile is held by the side whose units (or cities) are
    // within this many tiles and no other side's are; else neutral. proposal
    territory: (radius: 3, city_radius: 5),
    city: (capture_time: "5", defense_bonus: "0.5"),
    match_rules: (start_light_units: 3, win_city_share: "0.8"),

    water: (
        damage_dps: "3",    // HP/s for infantry in water
        ship_after: "5",    // seconds in water before turning into a ship
    ),

    // Per terrain: (speed, strength) multipliers for light / heavy, and the
    // defense bonus for a defender standing on the tile. Strength multiplies
    // both attack and defense of the unit (so a heavy in forest is weak, as in
    // spec 2.3). Mountains are impassable.
    terrain: (
        plain:    (light: ("1",   "1"),    heavy: ("1",   "1"),    defense: "0"),
        forest:   (light: ("1",   "1"),    heavy: ("0.5", "0.5"),  defense: "0.25"),
        hills:    (light: ("1",   "1"),    heavy: ("0.5", "0.5"),  defense: "0.5"),
        sand:     (light: ("0.6", "1"),    heavy: ("1",   "1"),    defense: "0"),
        snow:     (light: ("0.8", "0.75"), heavy: ("0.8", "0.75"), defense: "0"),
        mud:      (light: ("0.7", "0.75"), heavy: ("0.7", "0.75"), defense: "0"),
        water:    (light: ("0.5", "0.5"),  heavy: ("0.5", "0.5"),  defense: "0"),
        ship:     (light: ("1.5", "0.5"),  heavy: ("1.5", "0.5"),  defense: "0"),
        // Cities and bridges behave like plain; a city adds city.defense_bonus.
    ),
)
